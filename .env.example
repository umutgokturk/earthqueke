# ─────────────────────────────────────────────────────────────
# İSTANBUL LIVE SEISMIC — environment configuration
# Copy to .env and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database (PostgreSQL + PostGIS) ──────────────────────────
# Leave empty in development to run with the in-memory fallback store.
DATABASE_URL=postgres://ils:ils@localhost:5432/ils

# ── Redis (cache / rate limit / pub-sub between api & worker) ─
# Leave empty to run with the in-memory fallback cache/bus.
REDIS_URL=redis://localhost:6379

# ── Ports (single place — read from this file by api, worker and web) ──
# Site (Next.js) port. Change it here once; `npm run dev` picks it up.
WEB_PORT=3000
# API port. The web proxy (API_PROXY_TARGET) and browser WebSocket address
# (NEXT_PUBLIC_WS_URL) default to this port automatically.
API_PORT=4000

# ── Backend (apps/api) ───────────────────────────────────────
API_HOST=0.0.0.0
# Comma separated list of allowed browser origins (CORS + WS origin check)
WEB_ORIGIN=http://localhost:3000
# Run the ingestion engine inside the API process (single-process mode).
# Automatically enabled when DATABASE_URL is empty (memory store cannot be
# shared across processes). Set to "false" to force the separate worker.
EMBEDDED_INGESTION=

# ── Ingestion worker ─────────────────────────────────────────
# Polling interval for upstream sources (ms). Keep >= 15000 to stay polite.
INGESTION_INTERVAL_MS=20000
# Bounding box used when querying upstream APIs (Marmara region)
INGEST_MIN_LAT=39.8
INGEST_MAX_LAT=41.6
INGEST_MIN_LON=26.0
INGEST_MAX_LON=30.5

# ── Upstream data sources ────────────────────────────────────
AFAD_API_URL=https://deprem.afad.gov.tr/apiv2
KANDILLI_API_URL=https://www.koeri.boun.edu.tr/scripts/lst0.asp
# Enable the clearly-labelled mock provider (never runs when NODE_ENV=production)
MOCK_PROVIDER_ENABLED=true

# ── Duplicate detection thresholds ───────────────────────────
DEDUPE_TIME_SECONDS=90
DEDUPE_DISTANCE_KM=15
DEDUPE_MAGNITUDE_DELTA=0.7

# ── Frontend (apps/web) ──────────────────────────────────────
# Base URL of the REST API as seen from the browser.
# Leave empty to use the built-in same-origin proxy (recommended).
NEXT_PUBLIC_API_URL=
# WebSocket endpoint as seen from the browser.
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
# Where the Next.js server proxies /api/* requests to.
API_PROXY_TARGET=http://localhost:4000

# ── Map tiles (optional) ─────────────────────────────────────
# When set, the map uses the MapTiler dark vector style.
# Otherwise it falls back to the free Carto dark raster basemap.
MAPTILER_KEY=
NEXT_PUBLIC_MAPTILER_KEY=
MAPBOX_TOKEN=

# ── Admin authentication ─────────────────────────────────────
ADMIN_USERNAME=admin
# Preferred: bcrypt hash (generate with: npm run -w @ils/api hash-password -- 'yourpassword')
ADMIN_PASSWORD_HASH=
# Dev fallback: plaintext password, hashed in memory at startup, never stored.
ADMIN_PASSWORD=change-me
# Secret used to sign admin session tokens (JWT). Required in production.
ADMIN_JWT_SECRET=dev-only-secret-change-me

# ── Internal service auth (worker -> api fallback channel) ───
INTERNAL_API_TOKEN=
